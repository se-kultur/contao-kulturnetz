{#
    Gemeinsame Basis der Profilformulare (Anlegen und Bearbeiten, bisher
    mod_artist_add/edit.html5, mod_host_add/edit.html5, mod_location_add/edit.html5)
    auf dem Formularrahmen @Contao/kulturnetz/form/_shell.html.twig.

    Die Module kulturnetz_artist_form, kulturnetz_host_form und
    kulturnetz_location_form erweitern dieses Template und liefern im Block
    "profile_fields" die Fieldsets ihrer Profilart.

    Variablen (Controller unter src/Controller/FrontendModule/Profile/):
      mode           "add" oder "edit"
      profile_type   Typschlüssel ("artists", "hosts", "locations")
      profile_label  Beschriftung, z. B. "Künstler*innenprofil"
      help_key       Schlüssel des Hilfekastens (z. B. "artist_edit")
      record         Profilzeile, beim Anlegen und bei fremdem Profil leer
      avatar         Titelbild: src (Vorschau), uuid (Feld "avatar")
      categories     Sparten zur Auswahl (nur Künstler*innen) oder null

    Das Formular sendet an die Routen kulturnetz_profil_anlegen bzw.
    kulturnetz_profil_aendern. Die Ziele nach dem Speichern (Profilübersicht, bei
    Änderungen die Detailseite) stehen als data-Attribute in .profile-form-data für
    das Formular-JS (files/se-kultur.de/js/<art>form.js).
#}
{% extends '@Contao/kulturnetz/form/_shell.html.twig' %}

{% set is_edit = mode == 'edit' %}
{% set own_profiles_url = kulturnetz_page_url('own_profiles') %}
{% set detail_url = is_edit ? kulturnetz_page_url(profile_type ~ '.detail', record.alias|default('')) : null %}

{% set form_action = path(is_edit ? 'kulturnetz_profil_aendern' : 'kulturnetz_profil_anlegen', {typ: profile_type}) %}
{% set form_mode = mode %}
{% set form_class = 'artistform' %}
{% set headline = profile_label ~ (is_edit ? ' bearbeiten' : ' erstellen') %}
{% set cancel_url = own_profiles_url %}

{% block header_content %}
	{% if is_edit %}
		<a href="{{ detail_url }}" class="btn btn-primary">Profil ansehen</a>
		<a href="{{ detail_url }}#galerie" class="btn btn-outline">Fotos verwalten</a>
		<a href="{{ own_profiles_url }}" class="btn btn-outline">Zurück zur Profilübersicht</a>
	{% else %}
		<p>Im nachfolgenden Formular können Sie Ihr {{ profile_label }} für das SE-KulturNetz eingeben. Versuchen Sie, dabei möglichst alle Felder auszufüllen. Aber keine Angst, falls Sie etwas vergessen haben – Sie können Ihr Profil jederzeit bearbeiten.</p>
		<p class="hide-xs hide-sm hide-md">Rechts, in der blauen Leiste, finden Sie wichtige Hinweise und Tipps zu einzelnen Feldern, sobald Sie das entsprechende Eingabefeld angeklickt haben.</p>
		<p>Nach erfolgter Prüfung informieren wir Sie über die Freischaltung Ihres Profils per E-Mail.</p>
	{% endif %}
{% endblock %}

{% block fields %}
	<span class="profile-form-data" hidden data-url-overview="{{ own_profiles_url }}"{% if is_edit %} data-url-detail="{{ detail_url }}"{% endif %}></span>

	{% block profile_fields %}{% endblock %}
{% endblock %}

{% block consent_label %}
	{%- if is_edit -%}
		Ich versichere, alle Urheberrechte beachtet zu haben.
	{%- else -%}
		Mit der Erstellung meines {{ profile_label }}s erkläre ich mich damit einverstanden, dass die angegebenen Daten öffentlich im SE-KulturNetz bzw. auf der Webseite www.se-kultur.de einsehbar sind. Ich versichere, alle Urheberrechte beachtet zu haben.
	{%- endif -%}
{% endblock %}

{% block after_form %}
	{% include '@Contao/kulturnetz/form/_editor.html.twig' only %}
	{% if is_edit and record.id|default %}
		{% include '@Contao/kulturnetz/media/_uploader.html.twig' with {upload: 'avatar', type: profile_type, id: record.id} only %}
	{% else %}
		{% include '@Contao/kulturnetz/media/_uploader.html.twig' with {upload: 'avatar'} only %}
	{% endif %}
{% endblock %}
