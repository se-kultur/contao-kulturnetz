{#
 # Formular zum Anlegen und Bearbeiten eines Events der SE-KulturTage (Module
 # "ModuleSekEventAdd" und "ModuleSekEventEdit", bisher mod_sekevent_add.html5 und
 # mod_sekevent_edit.html5): zusätzlich mit Veranstaltungsformat, Werbemitteln und
 # Termin ohne Jahr. Felder in kulturnetz/event/_form.html.twig, Rahmen in
 # kulturnetz/form/_shell.html.twig.
 #}
{% extends '@Contao/kulturnetz/event/_form.html.twig' %}

{% block header_add %}
	<div class="bg-kulturnetz p-4 mb-1">
		<h3>SE-KulturTage &mdash; Event erstellen</h3>
		<p>Im nachfolgenden Formular können Sie Ihr Event für die SE-KulturTage eingeben. Versuchen Sie, dabei möglichst alle Felder auszufüllen. Aber keine Angst, falls Sie etwas vergessen haben – Sie können Ihr Event jederzeit bearbeiten.</p>
		<p class="hide-xs hide-sm hide-md">Rechts, in der blauen Leiste, finden Sie wichtige Hinweise und Tipps zu einzelnen Feldern, sobald Sie das entsprechende Eingabefeld angeklickt haben.</p>
		<p>Nach erfolgter Prüfung informieren wir Sie über die Freischaltung Ihres Events per E-Mail.</p>
	</div>

	{{ include('@Contao/kulturnetz/event/_form_profile_hint.html.twig') }}
{% endblock %}

{% block header_edit %}
	<div class="bg-kulturnetz p-4 mb-1">
		<h3>SE-KulturTage &mdash; Event bearbeiten</h3>
		<a href="{{ kulturnetz_page_url('sekevents.detail', values.alias) }}" class="btn btn-primary">Event ansehen</a>
		<a href="{{ kulturnetz_page_url('sekevents.detail', values.alias) }}#galerie" class="btn btn-outline">Fotos verwalten</a>
		<a href="{{ kulturnetz_page_url('own_events') }}" class="btn btn-outline">Zurück zur Übersicht</a>
	</div>
{% endblock %}

{% block avatar_info %}Das Titelbild Ihres Events wird auf unserer Webseite dargestellt und im Programmheft abgedruckt. Wir bitten Sie daher, ein aussagekräftiges Foto mit einer Auflösung von mindestens 1000 x 1000 Pixeln zu verwenden. Außerdem müssen die Bildrechte vorhanden sein - Fotograf*in oder Urheber*in muss angegeben werden.{% endblock %}

{% block format_field %}
		<div class="widget widget-select">
			<label class="mandatory">Veranstaltungsformat<span class="mandatory">*</span><a href="https://dev.se-jungekunst.de/se-kulturtage.html" target="_blank"><i class="fa-solid fa-circle-info"></i></a></label>
			<select name="kulturform">
				{% for format in formats %}
				<option{% if values.kulturform == format %} selected{% endif %}>{{ format }}</option>
				{% endfor %}
			</select>
		</div>

{% endblock %}

{% block advertising %}
	<fieldset>
		<legend>Werbemittel</legend>

		<p>Hier können Sie die Anzahl und die Art der {{ is_edit ? 'Printmittel' : 'Werbemittel' }} angeben, die wir Ihnen zur Verfügung stellen sollen.</p>

		<div class="widget widget-checkbox">
			<input type="checkbox" id="wimpelketten" name="wimpelketten"{% if '1' == values.wimpelketten %} checked{% endif %}>
			<label for="wimpelketten">Wimpelketten erbeten?</label>
		</div>

		<div class="widget widget-checkbox">
			<input type="checkbox" id="plakatentwurf" name="plakatentwurf"{% if '1' == values.plakatentwurf %} checked{% endif %}>
			<label for="plakatentwurf">Digitales Werbeplakat Ihrer Veranstaltung als PDF-Datei erwünscht? <br><span class="event-form-note"><i class="fa-solid fa-circle-info"></i> Erstellung ab August {{ current_year }} möglich</span></label>
		</div>

		<div class="widget widget-text event-form-count">
			<div class="inputgroup">
				<input type="number" value="{{ values.programmhefte }}" min="0" max="99" name="programmhefte">
				<span>Anzahl Programmhefte</span>
			</div>
		</div>

		<div class="widget widget-text event-form-count">
			<div class="inputgroup">
				<input type="number" value="{{ values.werbeplakate_a4 }}" min="0" max="99" name="werbeplakate_a4">
				<span>Anzahl Werbeplakate (<abbr title="Maße: 210 x 297mm">Format A4</abbr>)</span>
			</div>
		</div>

		<div class="widget widget-text event-form-count">
			<div class="inputgroup">
				<input type="number" value="{{ values.werbeplakate_a3 }}" min="0" max="99" name="werbeplakate_a3">
				<span>Anzahl Werbeplakate (<abbr title="Maße: 297 x 420mm">Format A3</abbr>)</span>
			</div>
		</div>

		<div class="widget widget-text event-form-count">
			<div class="inputgroup">
				<input type="number" value="{{ values.werbeplakate_a1 }}" min="0" max="99" name="werbeplakate_a1">
				<span>Anzahl Werbeplakate (<abbr title="Maße: 594 x 841mm">Format A1</abbr>)</span>
			</div>
		</div>

		<div class="widget widget-text event-form-count">
			<div class="inputgroup">
				<input type="number" value="{{ values.werbeplakate_a0 }}" min="0" max="99" name="werbeplakate_a0">
				<span>Anzahl Werbeplakate (<abbr title="Maße: 841 x 1189mm">Format A0</abbr>)</span>
			</div>
		</div>
	</fieldset>
{% endblock %}

{% block consent_label %}{% if is_edit %}Ich versichere, alle Urheberrechte beachtet zu haben und akzeptiere die {% else %}Mit der Erstellung meines Events erkläre ich mich damit einverstanden, dass die angegebenen Daten öffentlich in den SE-KulturTagen bzw. auf der Webseite www.se-kultur.de einsehbar sind. Ich versichere, alle Urheberrechte beachtet zu haben und akzeptiere die {% endif %}<a href="{{ kulturnetz_page_url('terms') }}" class="event-terms-link" target="_blank">Teilnahmebedingungen</a> und den <a href="{{ kulturnetz_page_url('terms') }}#awareness-konsens" class="event-terms-link" target="_blank">Awareness-Konsens</a>.{% endblock %}
