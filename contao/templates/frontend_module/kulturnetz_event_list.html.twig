{#
 # Liste der eigenen Veranstaltungen des Mitglieds, gemeinsames Template der Module
 # "ModuleEventsList" (Veranstaltungen) und "ModuleSekEventsList" (SE-KulturTage),
 # bisher mod_events_list.html5 und mod_sekevents_list.html5. Markup, Klassen und Texte
 # wie bisher, ohne Modul-Wrapper.
 #
 # Variablen (Controller unter src/Controller/FrontendModule/Event/):
 #   event_type  "events" oder "sekevents"
 #   member_id   angemeldetes Mitglied
 #   upcoming    Kacheln kommender Veranstaltungen ({event, image})
 #   past        Kacheln vergangener Veranstaltungen ({event, image})
 #   add_tile    Kachel "Neue Veranstaltung erstellen" anzeigen
 #}
<div class="artists-list mb-4">
	{% for card in upcoming %}
	{{ include('@Contao/kulturnetz/event/_card_list.html.twig', {event: card.event, image: card.image, event_type: event_type, member_id: member_id, past: false}, with_context: false) }}
	{% endfor %}

	{% if past is not empty %}
	<h6 class="mt-4">Vergangene Veranstaltungen</h6>
	{% for card in past %}
	{{ include('@Contao/kulturnetz/event/_card_list.html.twig', {event: card.event, image: card.image, event_type: event_type, member_id: member_id, past: true}, with_context: false) }}
	{% endfor %}
	{% endif %}

	{% if add_tile %}
	{% set add_href = kulturnetz_page_url(event_type ~ '.add') %}
	<div class="artist highlight">
		<a href="{{ add_href }}">
			<figure class="avatar">
				<img src="{{ asset('files/se-kultur.de/img/addavatar.jpg') }}" alt="Neue Veranstaltung erstellen">
			</figure>
		</a>

		<div class="infos">
			<div class="badges">
				<a href="{{ add_href }}" class="btn btn-primary btn-sm">
					<i class="fa-solid fa-plus"></i><span class="hide-sm hide-xs hide-md"> Veranstaltung erstellen</span>
				</a>
			</div>

			<a href="{{ add_href }}"><h6>Neue Veranstaltung erstellen</h6></a>
			<p class="beschreibung">
				{{ 'sekevents' == event_type ? 'Erstellen Sie jetzt kostenlos Ihre eigene Veranstaltung für die SE-KulturTage!' : 'Erstellen Sie jetzt kostenlos Ihre eigene Veranstaltung für das KulturNetz!' }}
			</p>
		</div>
	</div>
	{% endif %}
</div>
