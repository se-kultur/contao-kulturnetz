{
    "name": "se-kultur/contao-kulturnetz",
    "description": "Contao-Erweiterung zur Vernetzung von Kulturakteur*innen: Verwaltung von Künstler*innen, Veranstalter*innen, Locations und Veranstaltungen.",
    "license": "GPL-3.0-or-later",
    "type": "contao-bundle",
    "require": {
        "php": "^8.3",
        "contao/core-bundle": "^5.7",
        "doctrine/dbal": "^4.3",
        "imagine/imagine": "^1.3",
        "psr/clock": "^1.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/asset": "^7.4",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/filesystem": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/html-sanitizer": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/mailer": "^7.4",
        "symfony/mime": "^7.4",
        "symfony/rate-limiter": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/security-bundle": "^7.4",
        "symfony/security-core": "^7.4",
        "symfony/security-csrf": "^7.4",
        "symfony/service-contracts": "^3.0",
        "symfony/translation-contracts": "^3.0",
        "symfony/uid": "^7.4",
        "symfony/yaml": "^7.4",
        "tecnickcom/tc-lib-pdf": "^8.85",
        "twig/twig": "^3.21"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.3.1"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "SeKultur\\ContaoKulturnetzBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "SeKultur\\ContaoKulturnetzBundle\\ContaoManager\\Plugin"
    }
}
