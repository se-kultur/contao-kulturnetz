{
    "name": "se-kultur/contao-kulturnetz",
    "description": "Contao-Erweiterung zur Vernetzung von Kulturakteur*innen -- Verwaltung von Künstler*innen, Veranstalter*innen, Locations und Veranstaltungen.",
    "license": "GPL-3.0-or-later",
    "type": "contao-bundle",
    "require": {
        "php": "^8.3",
        "contao/core-bundle": "^5.7",
        "contao/image": "^1.2",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/http-kernel": "^7.4"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.3.1"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "SeKultur\\ContaoKulturnetzBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "SeKultur\\ContaoKulturnetzBundle\\ContaoManager\\Plugin"
    }
}
