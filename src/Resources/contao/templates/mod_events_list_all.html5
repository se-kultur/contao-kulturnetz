<?php 
global $objPage; 
$tage = [
	'Monday' => 'Montag',
	'Tuesday' => 'Dienstag',
	'Wednesday' => 'Mittwoch',
	'Thursday' => 'Donnerstag',
	'Friday' => 'Freitag',
	'Saturday' => 'Samstag',
	'Sunday' => 'Sonntag'
];

//$GLOBALS['TL_CSS'][] = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
//$GLOBALS['TL_JAVASCRIPT'][] = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
$GLOBALS['leaflet'] = true;
$GLOBALS['FOOTERJS'][] ='<script type="text/javascript" src="files/se-kultur.de/js/autocompleteEvents.js"></script>';  
?>
<style>.hidden {display:none !important;}</style>
<?php if(isset($this->filter) && @$this->filter == true): ?>
<?php
	// Alle Formularwerte kommen ausschließlich aus $this->search (siehe
	// ModuleEventsListAll::compile()), nicht mehr direkt aus $_GET: das
	// Array ist dort bereits auf skalare Strings normalisiert (kein "Array to
	// string conversion" bei ?datum[]=x) und wird unten für die
	// Vergangenheits-Ausblendung, den Zurücksetzen-Button und die
	// Orts-Badges wiederverwendet.
	//
	// Für die value-Attribute wird zusätzlich Contao\Input::encodeInsertTags()
	// angewendet (nach dem HTML-Escaping, wie auch Contao\Input::get() intern
	// verfährt): $_GET-Werte landen unverändert im gerenderten HTML, und
	// Contao ersetzt Insert-Tags (z. B. "{{env::request}}") über den
	// kompletten Template-Buffer. htmlspecialchars() allein schützt davor
	// nicht, da geschweifte Klammern keine HTML-Sonderzeichen sind.
	$searchDatum = \Contao\Input::encodeInsertTags(htmlspecialchars((string) ($this->search['datum'] ?? ''), ENT_QUOTES, 'UTF-8'));
	$searchText = \Contao\Input::encodeInsertTags(htmlspecialchars((string) ($this->search['text'] ?? ''), ENT_QUOTES, 'UTF-8'));
	$searchKategorie = $this->search['kategorie'] ?? null;
?>
<form method="get" id="search" class="formbody">
	<div class="widget widget-text eventdate">
		<label>Datum</label>
		<div class="inputgroup">
			<input type="text" name="datum" value="<?= $searchDatum ?>" placeholder="z. B. 01.09.<?= date('Y') ?>">
		</div>
	</div>

	<div class="widget widget-select">
		<label>Kategorie</label>
		<select name="kategorie">
			<option value="Alle"<?= ($searchKategorie == 'Alle') ? ' selected' : '' ?>>Alle Kategorien</option>
			<option<?= ($searchKategorie == 'Literatur') ? ' selected' : '' ?>>Literatur</option>
			<option<?= ($searchKategorie == 'Musik') ? ' selected' : '' ?>>Musik</option>
			<option<?= ($searchKategorie == 'Theater') ? ' selected' : '' ?>>Theater</option>
			<option<?= ($searchKategorie == 'Tanz') ? ' selected' : '' ?>>Tanz</option>
			<option<?= ($searchKategorie == 'Bildende Kunst') ? ' selected' : '' ?>>Bildende Kunst</option>
			<option<?= ($searchKategorie == 'Film') ? ' selected' : '' ?>>Film</option>
			<option<?= ($searchKategorie == 'Fotografie') ? ' selected' : '' ?>>Fotografie</option>
			<option<?= ($searchKategorie == 'Multimedial') ? ' selected' : '' ?>>Multimedial</option>
			<option<?= ($searchKategorie == 'Performance') ? ' selected' : '' ?>>Performance</option>
			<option<?= ($searchKategorie == 'Sonstiges') ? ' selected' : '' ?>>Sonstiges</option>
		</select>
	</div>

	<div class="widget widget-text">
		<label>Volltextsuche</label>
		<input name="text" type="text" placeholder="Namen oder Ort eingeben" value="<?= $searchText ?>">
	</div>
	
	
	<div>
		<button type="submit" class="btn btn-primary"><i class="fa-solid fa-magnifying-glass"></i><span class="hide-xs hide-sm hide-md"> Suchen</span></button>
		<?php
			// Der Zurücksetzen-Button soll nur erscheinen, wenn tatsächlich ein
			// Filter aktiv ist. Da das Suchformular per GET immer alle Felder
			// mitschickt, reicht isset() dafür nicht aus (wäre nach jedem Absenden
			// true), deshalb wird auf tatsächlich gesetzte Werte geprüft.
			$hatAktivenFilter = !empty($this->search['text'])
				|| !empty($this->search['datum'])
				|| (!empty($this->search['kategorie']) && $this->search['kategorie'] !== 'Alle');
		?>
		<?php if($hatAktivenFilter): ?>
		<a href="<?= $objPage->alias ?>.html" class="btn btn-outline"><i class="fa-solid fa-xmark"></i><span class="hide-xs hide-sm hide-md">  Zurücksetzen</span></a>
		<?php endif; ?>
	</div>
	
	<?php if(count($this->stats['location_orte']) > 0): ?>
	<div style="font-size: 0.8em; flex: 0 0 100%;">
		<!--Angezeigt werden <?= count($this->events) ?> von insgesamt <?= $this->stats['count'] ?> Veranstaltungen. -->
		Sie können die Ergebnisse auch nach Orten filtern:<br>
		<?php foreach($this->stats['location_orte'] as $loc => $vol): if(strlen(trim($loc)) > 0): ?>
		<?php
			// Bestehende Filter (Datum, Kategorie, Text) übernehmen und nur den
			// Text-Parameter auf den gewählten Ort setzen, statt die anderen
			// Filter zu verwerfen. $this->search enthält bereits ausschließlich
			// die bekannten, auf skalare Strings normalisierten Filterparameter
			// (nicht das komplette $_GET), damit weder von Contao selbst
			// gesetzte Parameter (z. B. "language" bei mehrsprachigen Setups)
			// noch beliebige fremde oder als Array übergebene Query-Parameter
			// in den Badge-Link übernommen werden.
			$locParams = $this->search;
			$locParams['text'] = $loc;
		?>
		<a href="{{page::alias}}.html?<?= htmlspecialchars(http_build_query($locParams, '', '&'), ENT_QUOTES, 'UTF-8') ?>" class="badge" style="color:#fff;"><?= htmlspecialchars((string) $loc, ENT_QUOTES, 'UTF-8') ?></a>
		<?php endif; endforeach; ?>
		<!--Alternativ können Sie die (gefilterten) Veranstaltungen auch auf einer <a href="#">Karte anzeigen</a> lassen.-->
	</div>
	<?php endif; ?>
</form>

<?php if(1 == 2): ?>
<div id="sekevents_map"></div>
<script>
	<?php 
	foreach ($this->events as $kdate => $artist): 
		$mapData[$artist->id] = [
			'name' => $artist->name,
			'location' => $artist->location_adresse.', '.$artist->location_plz.' '.$artist->location_ort
		];
	endforeach; 
	echo 'const mapdata = '.json_encode(array_values($mapData)).';';
	?>
</script>
<?php endif; ?>
<?php endif; ?>

<div class="artists-list">
	<?php
	$noavatarList = \SeKultur\ContaoKulturnetzBundle\Helper\ImageHelper::resize('files/se-kultur.de/img/noavatar.jpg', 272, 272, 'crop') ?: 'files/se-kultur.de/img/noavatar.jpg';
	$date = false;
	foreach($this->events as $kdate => $artist):

	if($objFile = \Contao\FilesModel::findByUuid($artist->avatar)) {
		$imgPath = \SeKultur\ContaoKulturnetzBundle\Helper\ImageHelper::resize($objFile->path, 272, 272, 'crop') ?: $objFile->path;
		$imgMeta = ($objFile->meta != NULL) ? unserialize($objFile->meta)['de'] : false;
	} else {
		$imgPath = $noavatarList;
	}
	
	$kdate = explode('_', $kdate);
	$kdate = $kdate[0];
	
	if($date == false || $date != date('d.m.Y', intval($kdate))):
	$date = date('d.m.Y', intval($kdate));
	?>
	<h4 class="mt-4"><i class="fa-solid fa-calendar-days"></i> Events am <span class="highlighter"><?= $date ?></span></h4>
	<?php endif; ?>
	
	<div class="artist">
		<a href="detailansicht-event/<?= $artist->alias ?>.html">
			<figure class="avatar">
				<img src="<?= $imgPath ?>" alt="<?= @$imgMeta['alt'] ?>" loading="lazy">
			</figure>
		</a>
		<div class="infos">
			<?php if($this->member_id == $artist->member_id): ?>
			<div class="badges">
				<?php if($artist->disable == '1'): ?>
				<span class="badge bg-error"><i class="fa-solid fa-eye-slash"></i><span class="hide-xs hide-sm hide-md"> Nicht öffentlich</span></span>
				<?php endif; ?>
				
				<!--<span class="badge bg-kulturnetz"><i class="fa-solid fa-circle-info"></i> Dein Profil</span>-->
				<?php if($artist->readonly !== '1'): ?>
				<a href="event-bearbeiten/<?= $artist->alias ?>.html" class="btn btn-primary btn-sm">
					<i class="fa-solid fa-pen-to-square"></i><span class="hide-sm hide-xs hide-md"> Event bearbeiten</span>
				</a>
				<?php else: ?>
				<button onClick="return false;" class="btn btn-primary btn-sm" disabled aria-label="Bearbeitung durch Admins deaktiviert" role="tooltip">
					<i class="fa-solid fa-pen-to-square"></i><span class="hide-sm hide-xs hide-md"> Event bearbeiten</span>
				</button>
				<?php endif; ?>
				<a href="detailansicht-event/<?= $artist->alias ?>.html#galerie" class="btn btn-outline btn-sm">
					<i class="fa-solid fa-images"></i><span class="hide-sm hide-xs hide-md"> Galerie</span>
				</a>
			</div>
			<?php endif; ?>
			
			<a href="detailansicht-event/<?= $artist->alias ?>.html"><h6><?= $artist->name ?></h6></a>
			<p class="beschreibung">
				<span style="font-weight: bold;"><i class="fa-regular fa-clock"></i>
				<?php $f = 0; foreach($artist->dates_formatted as $tstamp => $df): $tstamp = explode('_', $tstamp)[0]; ?>
					<?php if($tstamp > $kdate && $tstamp < ($kdate+86400)): ?>
						<?php if($f == 0): ?>
						<?= $tage[date('l', $tstamp)].', '.date('d.m.Y - H:i', $tstamp) ?> Uhr
						<?php else: ?>
						<?= '+ '.date('H:i', $tstamp) ?> Uhr
						<?php endif; ?>
					<?php $f++; endif; ?>
				<?php endforeach; ?>
				</span><br><br>
				
				<?= $artist->kurzbeschreibung ?><br><br>
				
				<?php if($artist->eintrittfrei == '1'): ?>
				<span class="badge">Eintritt frei</span>
				<?php endif; ?>
				<?php if($artist->spenden == '1'): ?>
				<span class="badge">Spenden erbeten</span>
				<?php endif; ?>
				<?php if($artist->anmeldung == '1'): ?>
				<span class="badge">Anmeldung erforderlich</span>
				<?php endif; ?>
				<?php if(strlen($artist->zielgruppen) > 0): ?>
				<?php foreach(explode(',', $artist->zielgruppen) as $z): ?>
				<span class="badge bg-kulturtage"><?= $z ?></span>
				<?php endforeach; ?>
				<?php endif; ?>
				
				<!--<strong>Nächster Termin:</strong> <?= date('d.m.y - H:i', $artist->nextdate) ?>-->
			</p>
			<div class="footer">
				<span class="sparten"><?= trim(strtoupper(str_replace(',',' | ',$artist->sparten))) ?></span>
				<span class="ort"><?= $artist->location_ort ?></span>
				<div>
					<a href="detailansicht-event/<?= $artist->alias ?>.html"><i class="fa-solid fa-arrow-right-long"></i></a>
				</div>
			</div>
		</div>
	</div>
	<?php endforeach; ?>
	
	<?php if(count($this->events) == 0): ?>
	<div class="flex wrap">
		<div class="col-4 col-sm-12">
			<img src="files/se-kultur.de/img/veranstaltungen-leer.png" alt="Veranstaltung erstellen" style="max-width: 100%;height: auto;">
		</div>
		
		<div class="col-8 col-sm-12">
			<h6>Keine Veranstaltung gefunden</h6>
			
			<p>Für den angegebenen Zeitraum haben wir keine Veranstaltung gefunden.</p>
			<p>Wenn Sie eine Veranstaltung erstellen möchten, registrieren Sie sich oder melden Sie sich an und erstellen Sie kostenlos Ihre erste Veranstaltung!</p>
			
			<a href="event-anlegen.html" class="btn btn-primary">
				<span><i class="fa-solid fa-plus"></i><span class="hide-sm hide-xs hide-md"> Veranstaltung erstellen</span>
			</a>
		</div>
	</div>
	<?php endif; ?>
</div>